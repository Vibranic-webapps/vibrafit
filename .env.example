# Neon Postgres: create a project at https://console.neon.tech
# Copy this file to .env and fill in real values. NEVER put real values in this file (it is committed).

# POOLED connection string (host contains "-pooler"): used by the app.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# DIRECT (unpooled) connection string: required by prisma migrate.
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# --- Mail (password reset) ---
# Resend API key (https://resend.com). Leave EMPTY in local dev: the reset
# link is then logged to the server console instead of being emailed.
RESEND_API_KEY=""
# Sender. The domain must be verified in Resend. Default if unset:
MAIL_FROM="Vibrafit <noreply@kilianfrederix.net>"

# Public base URL, used to build password-reset links.
# REQUIRED in production (the request's Host header is not trusted there).
# Local dev may leave it empty (falls back to the request origin).
NUXT_PUBLIC_SITE_URL="https://vibrafit.kilianfrederix.net"
